# Copy this file to .env and change the values:   cp .env.example .env
# .env is listed in .gitignore, so your real secrets never reach Git.
# Docker Compose reads .env automatically from the folder where compose.yaml lives.

POSTGRES_DB=taskapi
POSTGRES_USER=taskapi
POSTGRES_PASSWORD=change-me-to-something-long

APP_VERSION=dev
APP_LOG_LEVEL=info
