# ⚠️ NAIVE Dockerfile: kept on purpose as a "before" example. Do NOT use in production.
# Compare it with ./Dockerfile; docs/01-app-docker.md explains every problem in it.

FROM python:3.15

WORKDIR /app

COPY . .

RUN pip install -r requirements.txt -r requirements-dev.txt

CMD uvicorn taskapi.main:app --host 0.0.0.0 --port 8000
